{
  "name": "qda2-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/unit/register.mjs --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "validate:reference": "python3 scripts/validation/reference.py"
  },
  "dependencies": {
    "katex": "0.18.11",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "playwright-core": "1.56.1"
  }
}
